@page
@using PetCare.WebApp.Helpers
@model PetCare.WebApp.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people-fill"></i> User Management</h2>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body bg-light">
        <form method="get" class="row g-3">
            <input type="hidden" asp-for="SortColumn" />
            <input type="hidden" asp-for="SortDirection" />

            <div class="col-md-4">
                <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Search email or username...">
            </div>

            <div class="col-md-3">
                <select asp-for="FilterRole" asp-items="Model.RoleFilterOptions" class="form-select">
                    <option value="">-- All Roles --</option>
                </select>
            </div>

            <div class="col-md-3">
                <select asp-for="FilterStatus" class="form-select">
                    <option value="all">Status: All</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit"
                        class="btn btn-secondary btn-sm flex-grow-1 d-flex align-items-center justify-content-center"
                        title="Apply filters">
                    <i class="bi bi-funnel me-2"></i> Filter
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary btn-sm flex-grow-1 d-flex align-items-center justify-content-center"
                   title="Clear filters">
                    Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">
                            <a asp-page="./Index"
                               asp-route-sortColumn="Email"
                               asp-route-sortDirection="@Model.GetNextSort("Email")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-filterRole="@Model.FilterRole"
                               asp-route-filterStatus="@Model.FilterStatus"
                               class="text-decoration-none text-dark d-flex align-items-center">
                                Email / Username <i class="bi fs-5 ms-1 @Model.GetSortIcon("Email")"></i>
                            </a>
                        </th>

                        <th>Roles</th>

                        <th>
                            <a asp-page="./Index"
                               asp-route-sortColumn="Active"
                               asp-route-sortDirection="@Model.GetNextSort("Active")"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-filterRole="@Model.FilterRole"
                               asp-route-filterStatus="@Model.FilterStatus"
                               class="text-decoration-none text-dark d-flex align-items-center">
                                Active <i class="bi fs-5 ms-1 @Model.GetSortIcon("Active")"></i>
                            </a>
                        </th>

                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.UsersWithRoles)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@user.User.Email</div>
                                <small class="text-muted">@user.User.UserName</small>
                            </td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    var badgeClass = role == "Admin" ? "bg-danger" : (role == "Vet" ? "bg-success" : "bg-primary");
                                    <span class="badge @badgeClass">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.User.IsActive)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Yes</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>No</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="./ManageRoles" asp-route-userId="@user.User.Id" class="btn btn-sm btn-outline-dark">
                                    <i class="bi bi-gear"></i> Manage Access
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.UsersWithRoles.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-search display-6 d-block mb-2"></i>
                                No users found matching the criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>